# GEMINI_API_KEY: Required for Gemini image generation, room-photo compositing, and iterative refinements.
GEMINI_API_KEY=""

# GEMINI_IMAGE_MODEL: Optional override for the Gemini image model (defaults to gemini-nano-banana-2.1).
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"

# APP_URL: Public production URL where this site is hosted (e.g. https://casegoods.example.com).
# Used for absolute OpenGraph/Twitter preview URLs and links in concept emails.
APP_URL=""

# PORT: Optional server port (defaults to 3000; automatically set by Cloud Run / Render / Fly.io).
PORT="3000"

# STUDIO_ADMIN_PIN: Secret PIN required to view the Studio Concept Log in the UI & /api/generated-concepts.
# Leave blank to keep the log endpoint locked.
STUDIO_ADMIN_PIN=""
